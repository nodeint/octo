{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,ts}"
      ],
      "project": [
        "scripts/**"
      ]
    },
    "packages/*": {
      "entry": [
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "e2e": {
      "entry": [
        "src/**/*.specs.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/web": {
      "entry": [
        "src/routes/*.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreUnresolved": [
        "\\./\\+types/.*"
      ]
    },
    "packages/example": {
      "entry": [
        "src/constants.ts",
        "src/types.ts",
        "src/utils/index.ts"
      ]
    },
    "packages/ui": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/ds": {
      "ignoreDependencies": [
        "@fontsource-variable/inter"
      ]
    }
  }
}
